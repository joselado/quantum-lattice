launch_cwd = os.getcwd() # the directory quantum-lattice itself was launched from


def load_mode(mode):
  """Import a mode's <mode>.py as a page-builder module and return its
  built page widget (window). Mirrors what running `python <mode>.py`
  standalone does, minus the blocking window.run() at the bottom (guarded
  behind `if __name__ == "__main__"` in every mode script).

  Restores launch_cwd before each import: every mode's bootstrap captures
  its own `inipath = os.getcwd()` (used by save_results()/load_results()
  to write/read QL_save/ next to wherever the user launched the app from)
  before calling create_folder(), which chdirs into a fresh scratch
  folder - so without restoring launch_cwd here first, every mode after
  the first would instead capture the previous mode's scratch folder."""
  os.chdir(launch_cwd)
  moddir = os.path.join(qlroot,"interface-pyqt",mode)
  if moddir not in sys.path: sys.path.insert(0,moddir) # e.g. huge_0d's sibling handlers.py/islandbuild.py
  modname = "shell_mode_"+mode
  spec = importlib.util.spec_from_file_location(modname,os.path.join(moddir,mode+".py"))
  modobj = importlib.util.module_from_spec(spec)
  sys.modules[modname] = modobj # standard importlib practice; also lets tools/smoke_test.py introspect pages
  spec.loader.exec_module(modobj)
  return modobj.window


class _LazyPage(QWidget):
  """Placeholder shown in the shell's stackedWidget for a mode that
  hasn't been navigated to yet. Building a mode's page runs its
  <mode>.py top to bottom - importing pyqula submodules and, for some
  modes (e.g. huge_0d, which builds a full default 1260-atom geometry
  and Hamiltonian at import time), doing real work - which used to
  happen for all 14 modes at shell startup whether or not the user ever
  opened them. Deferring that to first navigation is what makes launch
  fast. This wrapper's own identity never changes (only its child does,
  see ensure_built()), so the nav item's click routing - wired by
  qfluentwidgets' addSubInterface against this wrapper object - keeps
  working correctly before and after the swap, with no need to touch
  qfluentwidgets' internal signal connections."""
  def __init__(self,mode,label):
    super().__init__()
    self.mode = mode
    self.label = label
    self.real_page = None
    # see the addSubInterface loop below for why this has to be
    # transparent too, not just the real page once built
    self.setStyleSheet("QWidget { background: transparent; }")
    layout = QVBoxLayout(self)
    layout.setContentsMargins(0,0,0,0)
    self._loading_label = QLabel("Loading "+label+" ...")
    self._loading_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
    layout.addWidget(self._loading_label)
    self._layout = layout

  def ensure_built(self):
    """Build the real page on first call; a cheap no-op afterwards.
    Refuses to build while some other page's handler (or another page's
    own build) is running: building a page calls create_folder(), which
    chdirs into a fresh scratch folder, and pyqula's cwd-relative I/O
    can't tolerate that racing against a handler's own chdir on its
    worker thread. Claiming the busy lock (qtwrap.try_acquire_busy(),
    the same lock a handler click claims) and only then building, rather
    than checking qtwrap.is_busy() first and building afterwards as two
    separate steps, is what closes the race where both could see "free"
    at the same instant and then chdir concurrently. The user just sees
    the "Loading..." placeholder a little longer; the shell retries
    automatically once the lock frees up (see Shell._retry_pending_page)
    rather than requiring the user to navigate away and back."""
    if self.real_page is not None: return self.real_page
    if not qtwrap.try_acquire_busy():
      self._loading_label.setText("Waiting for the current calculation to finish...")
      return self
    try:
      real_page = load_mode(self.mode)
    except Exception:
      # A mode's <mode>.py can raise at import time (bad widget lookup,
      # a broken pyqula call, ...) - report it instead of letting it
      # propagate uncaught (which used to leave this nav item stuck on
      # "Loading..." forever with nothing but a stderr traceback, no
      # InfoBar - unlike every button-handler failure elsewhere in the
      # app). self.real_page stays None, so navigating here again retries
      # the build. Reported before release_busy() below, not after -
      # release_busy() fires a synchronous became_free signal that can
      # reenter ensure_built() on some other pending page right here (see
      # the busy-lock-reentrancy gotcha); if that reentrant build also
      # fails, it must not be able to swallow this report.
      tb = traceback.format_exc()
      last_line = tb.strip().splitlines()[-1] if tb.strip() else "Something went wrong"
      self._loading_label.setText("Failed to load "+self.label+" - "+last_line)
      InfoBar.error(title="Failed to load "+self.label,content=last_line,
          parent=self,duration=6000,position=InfoBarPosition.TOP)
      print(tb)
      qtwrap.release_busy()
      return self
    real_page.setStyleSheet("QWidget { background: transparent; }")
    self._layout.removeWidget(self._loading_label)
    self._loading_label.deleteLater()
    self._layout.addWidget(real_page)
    # must be set before release_busy() below: release_busy() emits
    # became_free synchronously (same-thread signal), which
    # Shell._retry_pending_page() is connected to and which re-enters
    # ensure_built() on this same page if it still sees real_page as
    # None - re-acquiring the now-free lock and rebuilding the page
    # again, releasing the lock again, and so on forever. Setting
    # real_page first makes that reentrant check see the page as
    # already built, so it's a no-op instead of infinite recursion.
    self.real_page = real_page
    qtwrap.release_busy()
    return real_page


class HomePage(QWidget):
  """Landing page shown first when the shell opens, before the old
  behavior of just dropping the user onto whichever mode happened to be
  first in MODES with no orientation. Gives the app an identity (the old
  system_selection window's banner logo) and a one-click jump to every
  mode, grouped the same way as the sidebar (see MODES above) so the two
  stay in sync automatically."""
  def __init__(self,mode_entries,switch_to):
    # mode_entries: [(label,code,group,wrapper), ...], in MODES order;
    # switch_to: callable(wrapper) -> None, e.g. Shell.switchTo, used to
    # navigate there (also updates the sidebar's selection highlight).
    super().__init__()
    self.setStyleSheet("QWidget { background: transparent; }")
    outer = QVBoxLayout(self)
    outer.setContentsMargins(56,40,56,32)
    outer.setSpacing(0)

    logo = QLabel()
    logo.setAlignment(Qt.AlignmentFlag.AlignHCenter)
    logo_path = os.path.join(qlroot,"interface-pyqt","logos","quantum_lattice.png")
    logo_pixmap = QPixmap(logo_path)
    logo.setPixmap(logo_pixmap.scaledToWidth(640,Qt.TransformationMode.SmoothTransformation))
    outer.addWidget(logo)

    version = _read_version()
    if version is not None:
      version_label = CaptionLabel("Version "+version)
      version_label.setAlignment(Qt.AlignmentFlag.AlignHCenter)
      outer.addWidget(version_label)

    outer.addSpacing(28)

    scroll = QScrollArea()
    scroll.setWidgetResizable(True)
    scroll.setFrameShape(QFrame.Shape.NoFrame)
    scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")
    content = QWidget()
    content.setStyleSheet("QWidget { background: transparent; }")
    scroll.setWidget(content)
    # One column per group (side by side, wrapping to a new row only if the
    # window is too narrow to fit them all), rather than the old layout of
    # one full-width group section stacked above the next - each column
    # holds that group's header followed by its modes stacked vertically.
    content_layout = FlowLayout(content,needAni=False)
    content_layout.setContentsMargins(0,0,12,0)
    content_layout.setHorizontalSpacing(32)
    content_layout.setVerticalSpacing(20)

    columns = {} # group -> its QVBoxLayout, in first-seen order
    for label,code,group,wrapper in mode_entries:
      if group not in columns:
        column = QWidget()
        column.setStyleSheet("QWidget { background: transparent; }")
        column_layout = QVBoxLayout(column)
        column_layout.setContentsMargins(0,0,0,0)
        column_layout.setSpacing(8)
        column_layout.addWidget(StrongBodyLabel(group))
        columns[group] = column_layout
        content_layout.addWidget(column)
      btn = PushButton(text_icon(code),label)
      btn.setFixedHeight(36)
      btn.setMinimumWidth(260)
      btn.clicked.connect(lambda checked=False,w=wrapper: switch_to(w))
      columns[group].addWidget(btn)
    outer.addWidget(scroll,1)


# Repo location the "Update Quantum Lattice" button re-downloads from when
# there's no .git/ to `git pull` against (see _redownload_latest below) -
# matches origin's remote / README's own clone URL.
_GITHUB_ARCHIVE_URL = "https://github.com/joselado/quantum-lattice/archive/refs/heads/master.zip"


_GIT_PULL_TIMEOUT = 60 # seconds; a merge that needs interactive input or a
                        # remote demanding credentials with no TTY would
                        # otherwise hang forever while holding the shell-wide
                        # busy lock, freezing every other page/handler


def _git_pull():
  """Update qlroot via `git pull`, for a cloned install (has .git/).
  Uses `git -C` rather than os.chdir() so it never touches the
  process-wide cwd - important since this runs on a worker thread (see
  _UpdateRunner) while qtwrap's busy lock is held, and every mode's I/O
  is cwd-relative. Forces an English locale so the "already up to date"
  substring check below doesn't depend on the system's locale."""
  env = dict(os.environ,LANG="C",LC_ALL="C")
  try:
    result = subprocess.run(["git","-C",qlroot,"pull"],capture_output=True,text=True,
        env=env,timeout=_GIT_PULL_TIMEOUT)
  except subprocess.TimeoutExpired:
    raise RuntimeError("git pull timed out after "+str(_GIT_PULL_TIMEOUT)+"s "
        "(needs a merge message, or a remote asking for credentials?)")
  if result.returncode != 0:
    raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "git pull failed")
  output = result.stdout.strip()
  # Git >= 2.9 says "Already up to date."; older Git says "Already up-to-date."
  if "Already up to date" in output or "Already up-to-date" in output:
    return False,output or "Already up to date."
  return True,output or "Updated."


def _redownload_latest():
  """Update qlroot for a plain download (e.g. GitHub's "Download ZIP"),
  which has no .git/ to `git pull` against: re-fetch the latest master
  archive and swap it in for qlroot. There's no local history to diff
  against, so this always reports as an update (no cheap way to tell
  "nothing changed" without git), will silently overwrite any local edits,
  and - since it only adds/overwrites files rather than mirroring the
  archive exactly - won't remove a file that was deleted upstream. Good
  enough for keeping a downloaded copy current; a user who wants proper
  merge/diff behavior should use `git clone` instead.

  The merged tree is built in a staging directory *next to* qlroot (not
  under qlroot itself, and not under tempfile's default location, which
  may be a different filesystem/tmpfs) before qlroot is touched at all, so
  a failure while downloading/extracting/copying never touches the live
  install. qlroot is then swapped for the staged tree via rename (same
  filesystem, so it can't fail partway through the way a file-by-file copy
  onto the live tree could), keeping the old tree as a backup until the
  swap fully succeeds so a failure partway through can be undone."""
  qlroot_norm = os.path.normpath(qlroot)
  parent = os.path.dirname(qlroot_norm)
  staging = os.path.join(parent,".quantum-lattice-update-staging")
  backup = os.path.join(parent,".quantum-lattice-update-backup")
  for d in (staging,backup):
    if os.path.isdir(d): shutil.rmtree(d)
  with tempfile.TemporaryDirectory() as tmp:
    archive_path = os.path.join(tmp,"quantum-lattice.zip")
    try:
      urllib.request.urlretrieve(_GITHUB_ARCHIVE_URL,archive_path)
    except OSError as e:
      raise RuntimeError("Could not reach GitHub: "+str(e))
    with zipfile.ZipFile(archive_path) as zf:
      zf.extractall(tmp)
    # GitHub's archive always wraps everything in one top-level folder,
    # named after the repo/branch - discover it instead of hardcoding that
    # name, so a repo rename or default-branch change can't break this
    extracted_entries = [e for e in os.listdir(tmp)
                          if os.path.isdir(os.path.join(tmp,e))]
    if len(extracted_entries) != 1:
      raise RuntimeError("Unexpected archive layout from "+_GITHUB_ARCHIVE_URL)
    extracted = os.path.join(tmp,extracted_entries[0])
    shutil.copytree(qlroot,staging,symlinks=True)
    shutil.copytree(extracted,staging,dirs_exist_ok=True)
  os.rename(qlroot_norm,backup)
  try:
    os.rename(staging,qlroot_norm)
  except OSError:
    shutil.rmtree(qlroot_norm,ignore_errors=True)
    os.rename(backup,qlroot_norm)
    raise
  shutil.rmtree(backup,ignore_errors=True)
  return True,"Downloaded and installed the latest version from GitHub."


def _update_source():
  """Update qlroot in place, working whether this is a git clone (has
  .git/) or a plain download/extract (no .git/). Returns (updated,message):
  updated=False means nothing changed (already up to date); message is
  shown to the user either way."""
  if os.path.isdir(os.path.join(qlroot,".git")):
    return _git_pull()
  return _redownload_latest()


class _UpdateRunner(QThread):
  """Runs the git-pull-or-redownload + dependency refresh off the GUI
  thread, so a slow network fetch doesn't freeze the shell. The caller
  (Shell._update_qh) holds qtwrap's shell-wide busy lock for the whole
  run, the same lock a mode handler or a lazy page build claims, since
  rewriting files under qlroot must not race a handler's cwd-relative
  I/O or a page build's own chdir."""
  finished_ok = Signal(str)     # updated successfully - message for InfoBar.success
  finished_noop = Signal(str)   # nothing to update - message for InfoBar.info
  finished_error = Signal(str)  # failed - message for InfoBar.error
  def run(self):
    try:
      updated,message = _update_source()
    except Exception as e:
      self.finished_error.emit(str(e))
      return
    try:
      # always run these, even when the pull/redownload itself was a
      # no-op: if a previous click updated the source fine but then failed
      # here (e.g. create_icon() hit a permission error), the source is
      # already current so every later pull looks like a no-op too - only
      # retrying these unconditionally gives that failure a way to recover
      pycommand.install_requirements() # pick up any new/bumped dependency
      pycommand.install_editable()     # re-register the console script (pyproject.toml may have changed)
      pycommand.create_icon()
    except Exception as e:
      self.finished_error.emit("Failed to finish install: "+str(e))
      return
    if updated:
      self.finished_ok.emit(message)
    else:
      self.finished_noop.emit(message)


class Shell(FluentWindow):
  """Single-process shell: every mode is a page in one window's sidebar
  navigation, replacing the old system_selection window that spawned each
  mode as its own OS subprocess/top-level window."""
  def __init__(self):
    super().__init__()
    self.setWindowTitle("Quantum Lattice")
    mode_entries = [] # (label,code,group,wrapper) in MODES order, for the home page
    last_group = None
    for mode,label,code,group in MODES:
      if group != last_group:
        last_group = group
        self.navigationInterface.addItemHeader(group,position=NavigationItemPosition.SCROLL)
      icon = text_icon(code)
      wrapper = _LazyPage(mode,label)
      wrapper.setObjectName(mode) # addSubInterface requires a unique object name
      # Every mode's real page is a plain QMainWindow (unchanged from the
      # old standalone-window design, see qtwrap.new_page()), not one of
      # qfluentwidgets' own containers. Once ANY qfluentwidgets widget
      # inside it has its own stylesheet applied (see Phase 3's widget
      # promotion), Qt stops the plain QWidget containers (centralwidget,
      # tab pages, ...) from visually inheriting the shell's dark
      # background, and they paint an opaque default-palette (light)
      # background instead. Making them explicitly transparent restores
      # the shell's dark backdrop showing through - safe to do only here
      # (not in qtwrap.py itself), since a page run standalone via
      # `python <mode>.py` has no dark FluentWindow behind it to show
      # through and would otherwise render see-through/broken. Applied to
      # both _LazyPage itself (so the "Loading..." placeholder matches)
      # and the real page once ensure_built() swaps it in.
      self.addSubInterface(wrapper,icon,label,position=NavigationItemPosition.SCROLL)
      mode_entries.append((label,code,group,wrapper))
    self.home_page = HomePage(mode_entries,self.switchTo)
    self.home_page.setObjectName("home")
    self.addSubInterface(self.home_page,FIF.HOME,"Home",position=NavigationItemPosition.TOP)
    self.stackedWidget.currentChanged.connect(self._on_page_changed)
    # land on the home page rather than whichever mode happened to be
    # first in MODES, and force-build it now (a cheap no-op for a plain
    # QWidget, but matches the "always some page ready as soon as the
    # shell is visible" contract every later navigation relies on via
    # the same _on_page_changed() path).
    self.switchTo(self.home_page)
    self._on_page_changed(self.stackedWidget.currentIndex())
    self.navigationInterface.setExpandWidth(260)
    self._add_interface_theme_switch()
    self._add_plot_theme_switch()
    self._add_parallel_switch()
    self._add_cancel_button()
    self.navigationInterface.addItem(
        routeKey="update_qh",icon=FIF.UPDATE,text="Update Quantum Lattice",
        onClick=self._update_qh,position=NavigationItemPosition.BOTTOM)
    # a page whose first-navigation build was deferred by ensure_built()
    # (because a handler, or another page's own build, was running at the
    # time) would otherwise be stuck showing "Waiting..." until the user
    # happens to navigate away and back - retry it as soon as whatever
    # was running frees up instead.
    qtwrap.on_busy_free(self._retry_pending_page)

  def _retry_pending_page(self):
    """Called whenever the busy lock frees up (a handler finished, or a
    deferred page build completed elsewhere). If the page currently shown
    is a _LazyPage that deferred its own build earlier, retry it now."""
    widget = self.stackedWidget.currentWidget()
    if isinstance(widget,_LazyPage) and widget.real_page is None:
      self._on_page_changed(self.stackedWidget.currentIndex())

  def _add_interface_theme_switch(self):
    """Switch for the actual GUI theme (qfluentwidgets' setTheme()) -
    the FluentWindow chrome, nav panel, and every promoted widget's
    stylesheet - as opposed to _add_plot_theme_switch()'s QL_THEME,
    which only affects matplotlib/PyVista styling in the separate ql-*
    plotting subprocesses. setTheme() applies live (updateStyleSheet()),
    so no restart is needed."""
    container = QWidget(self.navigationInterface)
    layout = QHBoxLayout(container)
    layout.setContentsMargins(20,8,16,8)
    label = BodyLabel("Dark interface",container)
    switch = SwitchButton(container)
    switch.setOnText("")
    switch.setOffText("")
    switch.setChecked(True) # matches the setTheme(Theme.DARK) default set in main()
    switch.checkedChanged.connect(self._on_interface_theme_changed)
    layout.addWidget(label)
    layout.addStretch(1)
    layout.addWidget(switch)
    self.navigationInterface.panel.bottomLayout.addWidget(container)

  def _on_interface_theme_changed(self,checked):
    setTheme(Theme.DARK if checked else Theme.LIGHT)

  def _add_plot_theme_switch(self):
    """A single switch, shown once in the shell's nav panel rather than
    per-mode, since every mode is a page in this same process/window and
    shares the one QL_THEME env var every ql-* plotting subprocess reads
    (see plotstyle.py / _pv3d.py). Added directly to the nav panel's
    bottomLayout (a plain QVBoxLayout) rather than via addItem()/
    addWidget(), since those require a NavigationWidget subclass and this
    is a plain switch, not a nav destination."""
    container = QWidget(self.navigationInterface)
    layout = QHBoxLayout(container)
    layout.setContentsMargins(20,8,16,8)
    label = BodyLabel("Dark plots",container)
    switch = SwitchButton(container)
    switch.setOnText("")
    switch.setOffText("")
    switch.setChecked(True) # matches the QL_THEME default set in main()
    switch.checkedChanged.connect(self._on_plot_theme_changed)
    layout.addWidget(label)
    layout.addStretch(1)
    layout.addWidget(switch)
    self.navigationInterface.panel.bottomLayout.addWidget(container)

  def _on_plot_theme_changed(self,checked):
    # every ql-* script is launched afterward via subprocess.Popen with
    # no explicit env=, so it inherits this process's current os.environ
    # at that moment - no restart needed for the new value to take effect
    os.environ["QL_THEME"] = "dark" if checked else "light"

  def _add_parallel_switch(self):
    """Switch for serial vs. parallel execution of calculations
    (pyqula.parallel.cores, via qtwrap.set_parallel_execution() and
    common.check_parallel()) - a single switch here rather than a
    per-mode control, since every mode shares this one process/core
    count. Defaults off (serial): parallel numpy/scipy workers can
    oversubscribe a shared machine's cores if left on unconditionally,
    so a user has to opt in."""
    container = QWidget(self.navigationInterface)
    layout = QHBoxLayout(container)
    layout.setContentsMargins(20,8,16,8)
    label = BodyLabel("Parallel execution",container)
    switch = SwitchButton(container)
    switch.setOnText("")
    switch.setOffText("")
    switch.setChecked(False) # default: serial
    switch.checkedChanged.connect(self._on_parallel_execution_changed)
    layout.addWidget(label)
    layout.addStretch(1)
    layout.addWidget(switch)
    self.navigationInterface.panel.bottomLayout.addWidget(container)

  def _on_parallel_execution_changed(self,checked):
    qtwrap.set_parallel_execution(checked)

  def _add_cancel_button(self):
    """Cancel control for a subprocess-based calculation (see
    qtwrap.run_calculation_subprocess()/cancel_current_calculation()) - a
    single control here rather than per-page, since is_busy() is already a
    single process-wide flag and only one calculation ever runs at a time
    regardless of which page started it. Only a handful of handlers are
    migrated to the killable subprocess path so far (see each mode's own
    calc.py); clicking this while the running calculation (if any) is
    still the old in-process kind, or nothing is running at all, is a
    harmless no-op with its own InfoBar, rather than trying to track every
    busy-vs-cancellable transition with a second signal alongside
    is_busy()/on_busy_free()."""
    container = QWidget(self.navigationInterface)
    layout = QHBoxLayout(container)
    layout.setContentsMargins(20,8,16,8)
    button = PushButton("Cancel calculation",container)
    button.clicked.connect(self._on_cancel_calculation)
    layout.addWidget(button)
    self.navigationInterface.panel.bottomLayout.addWidget(container)

  def _on_cancel_calculation(self):
    if qtwrap.current_child_process is None:
      InfoBar.info(title="Nothing to cancel",
          content="No cancellable calculation is currently running",
          parent=self,duration=4000,position=InfoBarPosition.TOP)
      return
    qtwrap.cancel_current_calculation()

  def _on_page_changed(self,index):
    widget = self.stackedWidget.widget(index)
    if isinstance(widget,_LazyPage):
      widget = widget.ensure_built()
    # keep qtwrap's "active page" (what get()/getbox()/modify()/... resolve
    # against) in sync with whichever page navigation currently shows -
    # only the visible page's widgets can receive a click, so this is
    # always correct, matching qtwrap.new_page()'s own doc-comment.
    qtwrap.set_active(widget)

  def _update_qh(self):
    """git pull (cloned install) or re-download the latest source (plain
    download, no .git/) + refresh dependencies + recreate the launcher
    icon + relaunch - same end result the old system_selection window's
    "Update Quantum Lattice" button had, but off the GUI thread and with
    real success/failure feedback instead of a print() nobody sees when
    launched from the desktop icon."""
    if not qtwrap.try_acquire_busy_or_warn(self):
      return
    runner = _UpdateRunner()
    self._update_runner = runner # keep a live reference so Qt doesn't GC it mid-run
    runner.finished_ok.connect(self._on_update_ok)
    runner.finished_noop.connect(self._on_update_noop)
    runner.finished_error.connect(self._on_update_error)
    runner.start()

  def _on_update_ok(self,message):
    # no InfoBar here: the process exits right after run_qh() spawns the
    # new instance, so there's no time for one to be seen.
    # release_busy() fires a synchronous same-thread signal that can
    # reenter _retry_pending_page()->ensure_built()->load_mode() right
    # here (see the busy-lock-reentrancy gotcha) - relaunching first means
    # that reentrant call, if it ever raises, can no longer abort the
    # relaunch itself.
    pycommand.run_qh()
    qtwrap.release_busy()
    sys.exit()

  def _on_update_noop(self,message):
    # show the InfoBar before release_busy(), not after - see the comment
    # in _on_update_ok: release_busy()'s synchronous reentrancy could
    # otherwise abort this method before the message is ever shown
    InfoBar.info(title="Already up to date",content=message,
        parent=self,duration=4000,position=InfoBarPosition.TOP)
    qtwrap.release_busy()

  def _on_update_error(self,message):
    InfoBar.error(title="Update failed",content=message,
        parent=self,duration=6000,position=InfoBarPosition.TOP)
    qtwrap.release_busy()


def main():
  setTheme(Theme.DARK)
  # every ql-* plotting script launched via qlinterface.execute_script()
  # is a subprocess that inherits this process's environment, so setting
  # this once here is enough for utilities/plotstyle.py's apply() to pick
  # a matching dark style in all of them, no per-script wiring needed
  os.environ["QL_THEME"] = "dark"
  shell = Shell()
  shell.resize(1400,800)
  shell.show()
  qtwrap.ensure_app().exec()


if __name__ == "__main__":
  main()
