def _read_version():
    """VERSION.TXT's contents (e.g. "26.5.3"), or None if unreadable - the
    old system_selection landing page this HomePage replaces read the
    same file and showed a "Version X.Y" label; HomePage.__init__ below
    restores that so the running app's version is still visible somewhere."""
