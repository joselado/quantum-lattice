from PySide6.QtGui import QIcon, QPixmap, QPainter, QFont, QFontMetrics, QColor
from PySide6.QtCore import Qt, QRectF
from PySide6.QtWidgets import QWidget, QVBoxLayout, QLabel

from qfluentwidgets import FluentWindow, FluentIcon as FIF, setTheme, Theme, NavigationItemPosition

from interpreter import pycommand


def text_icon(text,box=96,color="#e8e8e8"):
  """Build a QIcon that renders `text` (a short module code like "1D",
  "moire", "Hy1D") centered on a transparent square, used in place of the
  stock FluentIcon glyphs in MODES below - those were unrelated stock
  pictograms next to each system type, not a real cue to what the module
  is. Rendered at a high resolution and shrunk-to-fit so it downscales
  crisply into the nav's fixed 16x16 icon slot."""
  pixmap = QPixmap(box,box)
  pixmap.fill(Qt.GlobalColor.transparent)
  painter = QPainter(pixmap)
  painter.setRenderHint(QPainter.RenderHint.Antialiasing)
  painter.setRenderHint(QPainter.RenderHint.TextAntialiasing)
  margin = box*0.04
  size = int(box*0.7)
  font = QFont()
  font.setBold(True)
  if len(text)>3: font.setLetterSpacing(QFont.SpacingType.PercentageSpacing,90)
  while size>6:
    font.setPixelSize(size)
    rect = QFontMetrics(font).boundingRect(text)
    if rect.width()<=box-2*margin and rect.height()<=box-2*margin: break
    size -= 1
  painter.setFont(font)
  painter.setPen(QColor(color))
  painter.drawText(QRectF(0,0,box,box),Qt.AlignmentFlag.AlignCenter,text)
  painter.end()
  return QIcon(pixmap)


