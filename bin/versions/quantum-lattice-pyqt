launch_cwd = os.getcwd() # the directory quantum-lattice itself was launched from


def load_mode(mode):
  """Import a mode's <mode>.py as a page-builder module and return its
  built page widget (window). Mirrors what running `python <mode>.py`
  standalone does, minus the blocking window.run() at the bottom (guarded
  behind `if __name__ == "__main__"` in every mode script).

  Restores launch_cwd before each import: every mode's bootstrap captures
  its own `inipath = os.getcwd()` (used by save_results()/load_results()
  to write/read QL_save/ next to wherever the user launched the app from)
  before calling create_folder(), which chdirs into a fresh scratch
  folder - so without restoring launch_cwd here first, every mode after
  the first would instead capture the previous mode's scratch folder."""
  os.chdir(launch_cwd)
  moddir = os.path.join(qlroot,"interface-pyqt",mode)
  if moddir not in sys.path: sys.path.insert(0,moddir) # e.g. huge_0d's sibling handlers.py/islandbuild.py
  modname = "shell_mode_"+mode
  spec = importlib.util.spec_from_file_location(modname,os.path.join(moddir,mode+".py"))
  modobj = importlib.util.module_from_spec(spec)
  sys.modules[modname] = modobj # standard importlib practice; also lets tools/smoke_test.py introspect pages
  spec.loader.exec_module(modobj)
  return modobj.window


class _LazyPage(QWidget):
  """Placeholder shown in the shell's stackedWidget for a mode that
  hasn't been navigated to yet. Building a mode's page runs its
  <mode>.py top to bottom - importing pyqula submodules and, for some
  modes (e.g. huge_0d, which builds a full default 1260-atom geometry
  and Hamiltonian at import time), doing real work - which used to
  happen for all 14 modes at shell startup whether or not the user ever
  opened them. Deferring that to first navigation is what makes launch
  fast. This wrapper's own identity never changes (only its child does,
  see ensure_built()), so the nav item's click routing - wired by
  qfluentwidgets' addSubInterface against this wrapper object - keeps
  working correctly before and after the swap, with no need to touch
  qfluentwidgets' internal signal connections."""
  def __init__(self,mode,label):
    super().__init__()
    self.mode = mode
    self.real_page = None
    # see the addSubInterface loop below for why this has to be
    # transparent too, not just the real page once built
    self.setStyleSheet("QWidget { background: transparent; }")
    layout = QVBoxLayout(self)
    layout.setContentsMargins(0,0,0,0)
    self._loading_label = QLabel("Loading "+label+" ...")
    self._loading_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
    layout.addWidget(self._loading_label)
    self._layout = layout

  def ensure_built(self):
    """Build the real page on first call; a cheap no-op afterwards.
    Refuses to build while some other page's handler (or another page's
    own build) is running: building a page calls create_folder(), which
    chdirs into a fresh scratch folder, and pyqula's cwd-relative I/O
    can't tolerate that racing against a handler's own chdir on its
    worker thread. Claiming the busy lock (qtwrap.try_acquire_busy(),
    the same lock a handler click claims) and only then building, rather
    than checking qtwrap.is_busy() first and building afterwards as two
    separate steps, is what closes the race where both could see "free"
    at the same instant and then chdir concurrently. The user just sees
    the "Loading..." placeholder a little longer; the shell retries
    automatically once the lock frees up (see Shell._retry_pending_page)
    rather than requiring the user to navigate away and back."""
    if self.real_page is not None: return self.real_page
    if not qtwrap.try_acquire_busy():
      self._loading_label.setText("Waiting for the current calculation to finish...")
      return self
    try:
      real_page = load_mode(self.mode)
      real_page.setStyleSheet("QWidget { background: transparent; }")
      self._layout.removeWidget(self._loading_label)
      self._loading_label.deleteLater()
      self._layout.addWidget(real_page)
      # must be set before release_busy() below: release_busy() emits
      # became_free synchronously (same-thread signal), which
      # Shell._retry_pending_page() is connected to and which re-enters
      # ensure_built() on this same page if it still sees real_page as
      # None - re-acquiring the now-free lock and rebuilding the page
      # again, releasing the lock again, and so on forever. Setting
      # real_page first makes that reentrant check see the page as
      # already built, so it's a no-op instead of infinite recursion.
      self.real_page = real_page
    finally:
      qtwrap.release_busy()
    return real_page


class HomePage(QWidget):
  """Landing page shown first when the shell opens, before the old
  behavior of just dropping the user onto whichever mode happened to be
  first in MODES with no orientation. Gives the app an identity (the old
  system_selection window's banner logo) and a one-click jump to every
  mode, grouped the same way as the sidebar (see MODES above) so the two
  stay in sync automatically."""
  def __init__(self,mode_entries,switch_to):
    # mode_entries: [(label,code,group,wrapper), ...], in MODES order;
    # switch_to: callable(wrapper) -> None, e.g. Shell.switchTo, used to
    # navigate there (also updates the sidebar's selection highlight).
    super().__init__()
    self.setStyleSheet("QWidget { background: transparent; }")
    outer = QVBoxLayout(self)
    outer.setContentsMargins(56,40,56,32)
    outer.setSpacing(0)

    logo = QLabel()
    logo.setAlignment(Qt.AlignmentFlag.AlignHCenter)
    logo_path = os.path.join(qlroot,"interface-pyqt","logos","quantum_lattice.png")
    logo_pixmap = QPixmap(logo_path)
    logo.setPixmap(logo_pixmap.scaledToWidth(640,Qt.TransformationMode.SmoothTransformation))
    outer.addWidget(logo)
    outer.addSpacing(28)

    scroll = QScrollArea()
    scroll.setWidgetResizable(True)
    scroll.setFrameShape(QFrame.Shape.NoFrame)
    scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")
    content = QWidget()
    content.setStyleSheet("QWidget { background: transparent; }")
    scroll.setWidget(content)
    content_layout = QVBoxLayout(content)
    content_layout.setContentsMargins(0,0,12,0)
    content_layout.setSpacing(20)

    last_group = None
    flow = None
    for label,code,group,wrapper in mode_entries:
      if group != last_group:
        content_layout.addWidget(StrongBodyLabel(group))
        flow_container = QWidget()
        flow_container.setStyleSheet("QWidget { background: transparent; }")
        flow = FlowLayout(flow_container,needAni=False)
        flow.setContentsMargins(0,0,0,0)
        content_layout.addWidget(flow_container)
        last_group = group
      btn = PushButton(text_icon(code),label)
      btn.setFixedHeight(36)
      btn.clicked.connect(lambda checked=False,w=wrapper: switch_to(w))
      flow.addWidget(btn)
    content_layout.addStretch(1)
    outer.addWidget(scroll,1)


class Shell(FluentWindow):
  """Single-process shell: every mode is a page in one window's sidebar
  navigation, replacing the old system_selection window that spawned each
  mode as its own OS subprocess/top-level window."""
  def __init__(self):
    super().__init__()
    self.setWindowTitle("Quantum Lattice")
    mode_entries = [] # (label,code,group,wrapper) in MODES order, for the home page
    last_group = None
    for mode,label,code,group in MODES:
      if group != last_group:
        if last_group is not None:
          self.navigationInterface.addSeparator(position=NavigationItemPosition.SCROLL)
        last_group = group
      icon = text_icon(code)
      wrapper = _LazyPage(mode,label)
      wrapper.setObjectName(mode) # addSubInterface requires a unique object name
      # Every mode's real page is a plain QMainWindow (unchanged from the
      # old standalone-window design, see qtwrap.new_page()), not one of
      # qfluentwidgets' own containers. Once ANY qfluentwidgets widget
      # inside it has its own stylesheet applied (see Phase 3's widget
      # promotion), Qt stops the plain QWidget containers (centralwidget,
      # tab pages, ...) from visually inheriting the shell's dark
      # background, and they paint an opaque default-palette (light)
      # background instead. Making them explicitly transparent restores
      # the shell's dark backdrop showing through - safe to do only here
      # (not in qtwrap.py itself), since a page run standalone via
      # `python <mode>.py` has no dark FluentWindow behind it to show
      # through and would otherwise render see-through/broken. Applied to
      # both _LazyPage itself (so the "Loading..." placeholder matches)
      # and the real page once ensure_built() swaps it in.
      self.addSubInterface(wrapper,icon,label,position=NavigationItemPosition.SCROLL)
      mode_entries.append((label,code,group,wrapper))
    self.home_page = HomePage(mode_entries,self.switchTo)
    self.home_page.setObjectName("home")
    self.addSubInterface(self.home_page,FIF.HOME,"Home",position=NavigationItemPosition.TOP)
    self.stackedWidget.currentChanged.connect(self._on_page_changed)
    # land on the home page rather than whichever mode happened to be
    # first in MODES, and force-build it now (a cheap no-op for a plain
    # QWidget, but matches the "always some page ready as soon as the
    # shell is visible" contract every later navigation relies on via
    # the same _on_page_changed() path).
    self.switchTo(self.home_page)
    self._on_page_changed(self.stackedWidget.currentIndex())
    self.navigationInterface.setExpandWidth(260)
    self._add_plot_theme_switch()
    self.navigationInterface.addItem(
        routeKey="update_qh",icon=FIF.UPDATE,text="Update Quantum Lattice",
        onClick=self._update_qh,position=NavigationItemPosition.BOTTOM)
    # a page whose first-navigation build was deferred by ensure_built()
    # (because a handler, or another page's own build, was running at the
    # time) would otherwise be stuck showing "Waiting..." until the user
    # happens to navigate away and back - retry it as soon as whatever
    # was running frees up instead.
    qtwrap.on_busy_free(self._retry_pending_page)

  def _retry_pending_page(self):
    """Called whenever the busy lock frees up (a handler finished, or a
    deferred page build completed elsewhere). If the page currently shown
    is a _LazyPage that deferred its own build earlier, retry it now."""
    widget = self.stackedWidget.currentWidget()
    if isinstance(widget,_LazyPage) and widget.real_page is None:
      self._on_page_changed(self.stackedWidget.currentIndex())

  def _add_plot_theme_switch(self):
    """A single switch, shown once in the shell's nav panel rather than
    per-mode, since every mode is a page in this same process/window and
    shares the one QL_THEME env var every ql-* plotting subprocess reads
    (see plotstyle.py / _pv3d.py). Added directly to the nav panel's
    bottomLayout (a plain QVBoxLayout) rather than via addItem()/
    addWidget(), since those require a NavigationWidget subclass and this
    is a plain switch, not a nav destination."""
    container = QWidget(self.navigationInterface)
    layout = QHBoxLayout(container)
    layout.setContentsMargins(20,8,16,8)
    label = BodyLabel("Dark plots",container)
    switch = SwitchButton(container)
    switch.setOnText("")
    switch.setOffText("")
    switch.setChecked(True) # matches the QL_THEME default set in main()
    switch.checkedChanged.connect(self._on_plot_theme_changed)
    layout.addWidget(label)
    layout.addStretch(1)
    layout.addWidget(switch)
    self.navigationInterface.panel.bottomLayout.addWidget(container)

  def _on_plot_theme_changed(self,checked):
    # every ql-* script is launched afterward via subprocess.Popen with
    # no explicit env=, so it inherits this process's current os.environ
    # at that moment - no restart needed for the new value to take effect
    os.environ["QL_THEME"] = "dark" if checked else "light"

  def _on_page_changed(self,index):
    widget = self.stackedWidget.widget(index)
    if isinstance(widget,_LazyPage):
      widget = widget.ensure_built()
    # keep qtwrap's "active page" (what get()/getbox()/modify()/... resolve
    # against) in sync with whichever page navigation currently shows -
    # only the visible page's widgets can receive a click, so this is
    # always correct, matching qtwrap.new_page()'s own doc-comment.
    qtwrap.set_active(widget)

  def _update_qh(self):
    """git pull + recreate the launcher icon + relaunch - same behavior
    the old system_selection window's "Update Quantum Lattice" button had."""
    os.chdir(qlroot)
    status = os.system("git pull") # fails loudly on local conflicts
    if status != 0:
      print("git pull failed, likely due to local changes; resolve manually and try again")
      return
    pycommand.create_icon()
    pycommand.run_qh()
    sys.exit()


def main():
  setTheme(Theme.DARK)
  # every ql-* plotting script launched via qlinterface.execute_script()
  # is a subprocess that inherits this process's environment, so setting
  # this once here is enough for utilities/plotstyle.py's apply() to pick
  # a matching dark style in all of them, no per-script wiring needed
  os.environ["QL_THEME"] = "dark"
  shell = Shell()
  shell.resize(1400,800)
  shell.show()
  qtwrap.ensure_app().exec()


if __name__ == "__main__":
  main()
