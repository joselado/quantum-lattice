#!/usr/bin/env python3

from __future__ import print_function
import numpy as np
import matplotlib.pyplot as plt
import sys
import os

import argparse
parser = argparse.ArgumentParser()
parser.add_argument("--before",default="POSITIONS_UNRELAXED.OUT",
        help='Positions before relaxation')
parser.add_argument("--after",default="POSITIONS_RELAXED.OUT",
        help='Positions after relaxation')
args = parser.parse_args() # get the arguments

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import plotstyle
plotstyle.apply()
import _cell

m0 = np.genfromtxt(args.before).transpose() # positions before relaxation
m1 = np.genfromtxt(args.after).transpose() # positions after relaxation
x0,y0 = m0[0],m0[1]
x1,y1 = m1[0],m1[1]

# the relaxation displacement is a small fraction of a bond length (see
# pyqula/graphenetk/relax.py's docstring) - a plain unscaled scatter of
# the before/after panels would look identical, so a third panel shows
# the displacement field as a quiver plot instead
dx,dy = x1-x0,y1-y0
u = np.sqrt(dx**2 + dy**2)
umax = np.max(u) if len(u) else 0.0

# a dedicated colorbar column (rather than fig.colorbar(...,ax=ax2)) keeps
# ax2's box the same width as ax0/ax1 - stealing space from ax2 itself
# would otherwise make its aspect="equal" content look smaller than theirs
fig = plt.figure(figsize=(16,5.5),constrained_layout=True)
gs = fig.add_gridspec(1,4,width_ratios=[1,1,1,0.045],wspace=0.3)
ax0 = fig.add_subplot(gs[0,0])
ax1 = fig.add_subplot(gs[0,1],sharex=ax0,sharey=ax0)
ax2 = fig.add_subplot(gs[0,2],sharex=ax0,sharey=ax0)
cax = fig.add_subplot(gs[0,3])
fig.canvas.setWindowTitle('Structure before/after relaxation')
fig.set_facecolor(plotstyle.BACKGROUND)

size = 500./np.sqrt(len(x0)) if len(x0) else 10.

ax0.scatter(x0,y0,color=plotstyle.PRIMARY,s=size)
ax0.set_title(str(len(x0))+" atoms (before)")

ax1.scatter(x1,y1,color=plotstyle.PRIMARY,s=size)
ax1.set_title("after relaxation")

# arrows autoscaled to a visible length (true 1:1 scale would be
# imperceptible); the quiverkey states the actual magnitude that scale
# corresponds to so the plot stays honest about the true displacement size
q = ax2.quiver(x0,y0,dx,dy,u,cmap="inferno",angles="xy",
        pivot="mid",width=0.005)
if umax>0:
  ax2.quiverkey(q,0.5,-0.06,umax,"max = %.4f" % umax,labelpos="E",
        coordinates="axes")
ax2.set_title("displacement field")
fig.colorbar(q,cax=cax,label="|u| (bond lengths)")

# same cell on all three panels, same unscaled limits/aspect so a domain
# that visibly shrinks/grows under relaxation isn't an artifact of the
# panels being scaled differently; sharex/sharey above also links zoom/pan
# interactively across all three panels
xmin,xmax = min(x0.min(),x1.min()),max(x0.max(),x1.max())
ymin,ymax = min(y0.min(),y1.min()),max(y0.max(),y1.max())
axes = (ax0,ax1,ax2)
for ax in axes:
    ax.set_xticks([])
    ax.set_yticks([])
    ax.set_aspect("equal")
ax0.set_xlim(xmin,xmax)
ax0.set_ylim(ymin,ymax)

cell = _cell.read_cell()
if cell is not None:
  dim, vecs = cell
  edges = _cell.cell_edges(dim,vecs) if dim!=1 else \
          _cell.cell_1d_ticks(vecs,np.column_stack([x0,y0,y0*0.]))
  for ax in axes:
    for (p0,p1) in edges:
      ax.plot([p0[0],p1[0]],[p0[1],p1[1]],color=plotstyle.ACCENT,
                linestyle="--",linewidth=1.8,zorder=10)

plt.show()
