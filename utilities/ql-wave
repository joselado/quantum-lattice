#!/usr/bin/env python3

import os
import sys
import numpy as np

dirname = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0,dirname)
import _pv3d

name = sys.argv[1]
m = np.genfromtxt(name).transpose() # read file

x,y,s = m[0],m[1],m[2]
part = np.sum(s*s)

print("Participation Ratio = ",part)

s = s/np.max(s)  # normalize
zeros = y*0.

pl = _pv3d.new_plotter()
_pv3d.add_atoms(pl,(x,y,zeros),color="black")
# a halo around each atom, not add_scaled_points: that renders in
# screen pixels, so it would drift out of registration with the
# (correctly world-sized) atoms above as the camera zooms - see
# add_atoms_colored's docstring
points = np.asarray((x,y,zeros)).T
nn = _pv3d.nearest_neighbor_distance(points)
_pv3d.add_atoms(pl,(x,y,zeros),color="red",radius=nn/1.5,opacity=0.7)
pl.show()
