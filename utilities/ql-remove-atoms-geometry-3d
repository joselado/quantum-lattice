#!/usr/bin/env python3

import os
import sys
import numpy as np
import pyvista as pv

dirname = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0,dirname)
import _pv3d


def read_positions():
  """Reads the positions of the system"""
  return np.genfromtxt("POSITIONS.OUT").transpose()


(x1,y1,z1) = read_positions()
points = np.array([x1,y1,z1]).T
removed = [False for x in x1] # none removed

pl = _pv3d.new_plotter()
namefile = "REMOVE_ATOMS.INFO"


def write_selection():
    with open(namefile,"w") as fo:
        for i,r in enumerate(removed):
            if r: fo.write(str(i)+"\n")
    print("Written selected atoms in "+namefile)


def redraw():
    """Blue for kept atoms, red for atoms marked for removal"""
    cloud = pv.PolyData(points)
    cloud["removed"] = np.array([1 if r else 0 for r in removed])
    pl.add_mesh(cloud,render_points_as_spheres=True,point_size=40,
                scalars="removed",cmap=["blue","red"],clim=[0,1],
                show_scalar_bar=False,name="atoms")


redraw()


def picker_callback(point_id):
    """ Called when the user clicks on a point: toggles its removal"""
    removed[point_id] = not removed[point_id]
    redraw()
    _pv3d.add_text(pl,"Selected atom "+str(point_id)+" ",position="upper_edge",name="pick_title")
    write_selection()


def area_callback(indices):
    """Called when a rectangle drag-select completes: marks every
    enclosed atom for removal, for bulk selection instead of clicking
    sites one by one."""
    for i in indices: removed[i] = True
    redraw()
    _pv3d.add_text(pl,str(len(indices))+" atoms selected",position="upper_edge",name="pick_title")
    write_selection()


# A rectangle click-drag is also the trackball camera's rotate gesture,
# so single-atom picking and area picking can't both be active at once
# (PyVista raises PyVistaPickingError if you try) - press "a" to switch
# between them. In area mode, PyVista's own rectangle-picking tool still
# needs its usual "r" to start/stop drawing a rectangle (see the on-screen
# message it prints), same as calling it stand-alone would.
mode = {"active": None}

def enable_point_mode():
    if mode["active"] is not None: pl.disable_picking()
    _pv3d.enable_point_picking(pl,points,picker_callback)
    mode["active"] = "point"
    _pv3d.add_text(pl,"Click mode: click an atom to toggle it  (press 'a' for area-select)",
                position="lower_edge",font_size=10,name="mode_title")

def enable_area_mode():
    if mode["active"] is not None: pl.disable_picking()
    _pv3d.enable_area_picking(pl,points,area_callback)
    mode["active"] = "area"
    _pv3d.add_text(pl,"Area mode: press 'r' then drag a rectangle to bulk-select  (press 'a' for click mode)",
                position="lower_edge",font_size=10,name="mode_title")

def toggle_mode():
    if mode["active"]=="point": enable_area_mode()
    else: enable_point_mode()

pl.add_key_event("a",toggle_mode)
enable_point_mode() # start in single-atom click mode, as before
pl.show()
